switch (wire_type)
{
    case 0:
        familia = "vermelho";
        cor = make_color_rgb(255, 40, 40);
    break;

    case 1:
        familia = "vermelho";
        cor = make_color_rgb(255, 120, 30);
    break;

    case 2:
        familia = "vermelho";
        cor = make_color_rgb(255, 120, 120);
    break;

    case 3:
        familia = "vermelho";
        cor = make_color_rgb(255, 80, 180);
    break;

    case 4:
        familia = "azul";
        cor = make_color_rgb(40, 80, 255);
    break;

    case 5:
        familia = "azul";
        cor = make_color_rgb(0, 220, 255);
    break;

    case 6:
        familia = "azul";
        cor = make_color_rgb(100, 80, 255);
    break;

    case 7:
        familia = "azul";
        cor = make_color_rgb(80, 120, 255);
    break;

    case 8:
        familia = "verde";
        cor = make_color_rgb(40, 220, 40);
    break;

    case 9:
        familia = "verde";
        cor = make_color_rgb(120, 255, 40);
    break;

    case 10:
        familia = "verde";
        cor = make_color_rgb(120, 180, 70);
    break;

    case 11:
        familia = "verde";
        cor = make_color_rgb(0, 180, 120);
    break;
}